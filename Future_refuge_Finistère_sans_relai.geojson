{ "type": "Feature", "properties": { "fid": 2, "nom": "L'Arche de Noé", "info": "Située à Brest, L'Arche de Noé a pour principe de recueillir en priorité les chats blessés, les chats risquant d'être euthanasiés par leurs propriétaires sans raison valable, ceux qui sont abandonnés ou captés par la fourrière, sans a-priori sur leur apparence, leur sociabilité ou leur \"adoptabilité\".\n\nEn moyenne nous accueillons entre 500 et 600 chats dans l'année et une cinquantaine de chiens.", "type": "Association", "type_structure": "Refuge", "domaine": "Public", "taille_personnel": null, "accueil_type": "Global", "capacité": null, "adresse": "20 Rue Amiral Romain Desfosses, 29200 Brest", "mail": "contact@arche-noe.bzh", "tel": "+33616643980", "url": "http://www.arche-de-noe-brest.fr/", "prox_epa_nom": null, "prox_epa_distance": null, "prox_ville_nom": null, "prox_ville_distance": null, "access_voie": null, "date_creation": null, "date_modif": null, "last_modif_user_name": null, "lien_ext": null, "priorite": null, "creation_user_name": null, "Statut": null, "Frequence": null }, "geometry": { "type": "Point", "coordinates": [ 147384.786276355851442, 6840125.702324925921857 ] } },
